# ──────────────────────────────────────────────
# Advanced Subscription & Membership Platform — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env.local and fill in real values.
# Do not commit .env.local to version control.

# ── Clerk Authentication ──
# Get these from https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/AdvancedSubscription_MembershipPlatform

# Optional. Used for Checkout / Billing Portal return URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required in production for /api/cron/analytics/daily-rollup
CRON_SECRET=

# Cloudflare R2 storage
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_URL=

# ── Stripe (test or live) ──
# Get from https://dashboard.stripe.com → Developers → API keys
# Webhook secret comes from a configured webhook endpoint.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Clerk Route Overrides ──
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/library
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/library
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/library
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/library

# ── Admin Email Allowlist ──
# Comma-separated emails that should be treated as admin.
# These users log in through /login like everyone else.
# Admins are redirected to /admin after login.
ADMIN_EMAILS=admin@example.test

# ──────────────────────────────────────────────
# REQUIRED CLERK DASHBOARD SETTINGS
# ──────────────────────────────────────────────
#
# You MUST enable these in your Clerk Dashboard
# (https://dashboard.clerk.com):
#
# 1. Email and Password:
#    → User & Authentication → Email, Phone, Username
#    → Enable "Email address" as identifier
#    → Enable "Password" as authentication strategy
#
# 2. Required Email Address:
#    → Ensure email is required (not optional)
#
# 3. Email Verification Code at Signup:
#    → User & Authentication → Email, Phone, Username
#    → Set "Verify at sign-up" to "Email verification code"
#
# 4. Password Reset:
#    → User & Authentication → Email, Phone, Username
#    → Enable "Allow password reset" (email code strategy)
#
# 5. Google OAuth:
#    → User & Authentication → Social Connections
#    → Enable "Google"
#    → Add your Google OAuth Client ID and Secret
#
# 6. Redirect URLs (localhost):
#    → Settings → Paths → Allowed redirect origins
#    → Add: http://localhost:3000
#    → Add: http://localhost:3001
#
# 7. Production Redirect URLs (later):
#    → Add your production domain when deploying
#
# ──────────────────────────────────────────────
